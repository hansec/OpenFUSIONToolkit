reset
undo off

# Cylinder geometry [m]: plasma (a), outer radius of fluid vacuum region (rv) and wall (b) radii
# hz is half of the periodic length (L = 2*pi*R0 with R0 = 0.5 m)
#{a = 0.1}
#{rv = 0.125}
#{b = 0.2}
#{hz = PI*0.5}
# Resolution: circumferential, radial (core, fluid vacuum, wall) and axial (half length)
#{nth = 24}
#{nr_core = 8}
#{nr_vac = 3}
#{nr_wall = 2}
#{nz = 3}

create surface circle radius {b} zplane
sweep surface 1 vector 0 0 1 distance {hz}
# Volume 1: rv < r < b, Volume 2: a < r < rv, Volume 3: r < a
webcut volume 1 with cylinder radius {rv} axis z center 0 0 0
webcut volume 2 with cylinder radius {a} axis z center 0 0 0
imprint all
merge all

# Mesh cross-section (z = 0) and sweep along z
curve in surface 6 12 15 interval {nth}
curve in surface 6 12 15 scheme equal
surface 15 scheme circle interval {nr_core} fraction 0.5
surface 12 scheme hole rad_intervals {nr_vac} bias 0
surface 6 scheme hole rad_intervals {nr_wall} bias 0
mesh surface 6 12 15
volume 1 2 3 interval {nz}
volume 1 scheme sweep source surface 6 target surface 5
volume 2 scheme sweep source surface 12 target surface 11
volume 3 scheme sweep source surface 15 target surface 14
mesh volume 1 2 3

# Blocks: 1 = plasma + fluid vacuum region, 2 = solid vacuum region
set duplicate block elements off
block 1 volume 2 3
block 2 volume 1
block all element type hex27
# Periodic face (z = hz), matched to z = -hz following reflection
nodeset 1 surface 5 11 14

quality volume all shape
export Genesis "MUG-cyl_pinch.g" overwrite
