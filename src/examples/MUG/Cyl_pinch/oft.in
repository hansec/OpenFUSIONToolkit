&runtime_options
 debug=0                   ! Debug verbosity level
/

&mesh_options
 meshname='cyl_pinch'      ! Name of mesh
 cad_type=0                ! Native mesh format
 nlevels=2                 ! Number of mesh levels (base mesh is distributed on level 2)
 nbase=1                   ! Level to decompose mesh for MPI
 grid_order=2              ! Use quadratic mesh mapping
/

&native_mesh_options
 filename='MUG-cyl_pinch.h5' ! Mesh file
 reflect=T                 ! Reflect mesh across z=0 plane
 ref_periodic=T            ! Make mesh periodic in z after reflection
 cyl_mesh=T                ! Place quadratic nodes on circles about the z-axis
 cyl_rmin=0.07             ! Only curve entities with average radius > 0.07 m
/

&cyl_pinch_options
 order=2                   ! FE order
 minlev=3                  ! Lowest FE level (single level, no multigrid)
 eq_file='kink_eq.dat'     ! Equilibrium profile file (from create_eq.py)
 a=0.1                     ! Plasma radius [m]
 mm=2                      ! Poloidal mode number of perturbation
 nn=1                      ! Axial mode number of perturbation
 db=1.E-5                  ! Perturbation amplitude [T]
 eta_vac=1.E4              ! Vacuum resistivity enhancement factor
 vac_start=0.005           ! Start of vacuum resistivity ramp outside plasma [m]
 vac_width=0.01            ! Width of vacuum resistivity ramp [m]
 plot_run=F                ! Perform post-processing run?
 pm=F                      ! Print solver progress?
/

&xmhd_options
 xmhd_adv_den=T            ! Advance density
 xmhd_adv_temp=T           ! Advance temperature
 bbc='bc'                  ! Perfectly-conducting BC for B-field
 vbc='all'                 ! Zero-flow BC for velocity
 nbc='d'                   ! Dirichlet BC for density
 tbc='d'                   ! Dirichlet BC for temperature
 dt=1.E-7                  ! Time step [s]
 eta=5.0                   ! Resistivity [m^2/s]
 visc_type='iso'           ! Isotropic viscosity
 nu_visc=5.0               ! Fluid viscosity [m^2/s]
 d_dens=1.0                ! Density diffusion [m^2/s]
 kappa_par=1.0             ! Parallel thermal conduction [m^2/s]
 kappa_perp=1.0            ! Perpendicular thermal conduction [m^2/s]
 nsteps=120                ! Number of time steps to take
 rst_freq=10               ! Restart file frequency
 lin_tol=1.E-9             ! Linear solver tolerance
 mu_ion=2.                 ! Ion mass (atomic units)
 xmhd_prefreq=1000         ! Preconditioner update frequency (> nsteps: factor once)
/

&xmhd_plot_options
 t0=1.E-8                  ! Time of first plot
 dt=1.E-6                  ! Time between plots
 rst_end=120               ! Index of last restart file
/
